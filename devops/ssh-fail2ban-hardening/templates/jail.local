# fail2ban 机队基线配置
# 部署位置：/etc/fail2ban/jail.local
# 注意：不要改 jail.conf（包管理器会覆盖），只写 jail.local。
# 注意：jail.local 里重定义 [DEFAULT] 时，该段会整体覆盖 jail.conf 的对应段，
#       所以下面把四参数与 ignoreip 都写全，不自带任何隐含缺省。

[DEFAULT]
bantime  = 1d
findtime = 10m
maxretry = 3

# 现代 Debian/Ubuntu 只写 journald，没有 /var/log/auth.log。
# 写成 auto/file 会导致“服务正常但永远检不到日志”。
backend  = systemd

# 全机队互信白名单：回环 + 每一台对等主机（家宽/VPS/备份源/跳板机）
# 家宽类 IP 是动态的，改 IP 后必须回来更新本行，并同步到其余主机的 jail.local。
# 多行写法（fail2ban 允许换行续写，可读性更好）：
# ignoreip = 127.0.0.1/8
#            ::1
#            129.146.122.202
#            129.153.89.114
#            64.64.237.34
ignoreip = 127.0.0.1/8 ::1 <PEER_IP_1> <PEER_IP_2> <PEER_IP_3>

[sshd]
enabled  = true
port     = 22
mode     = normal
